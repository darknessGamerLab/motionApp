# Admin API — bu dosyayı .env olarak kopyala; .env’i repoya ekleme.
#
# SUPABASE_URL — Dashboard → Project Settings → API → Project URL (https://….supabase.co)
# SUPABASE_SERVICE_KEY — aynı sayfada "service_role" (secret). Tarayıcıya verme.
# ADMIN_API_KEY — panel isteklerinde X-Admin-Key başlığı için senin belirlediğin gizli değer
#
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ADMIN_API_KEY=
PORT=5000
